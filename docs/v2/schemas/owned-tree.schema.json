{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AGP content-bound owned tree manifest v1alpha1",
  "description": "Local installation input, not runtime baseline or execution authority. Go checks duplicate paths, full parent closure, normalized ordering, canonical digest, 1 MiB document, 4 MiB/file and 64 MiB total, and live filesystem properties. Size/counters are UInt63 strings; POSIX UID/GID are uint32 JSON integers.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "agp.owned-tree/v1alpha1"
    },
    "nodeId": {
      "$ref": "shared.schema.json#/$defs/Id"
    },
    "siteId": {
      "$ref": "shared.schema.json#/$defs/Id"
    },
    "root": {
      "type": "string",
      "minLength": 2,
      "maxLength": 1024,
      "pattern": "^/",
      "allOf": [
        {
          "pattern": "^[!-~]+$"
        },
        {
          "not": {
            "anyOf": [
              {
                "pattern": "\\\\|[^!-~]"
              },
              {
                "pattern": "//|/$|(?:^|/)\\.{1,2}(?:/|$)"
              }
            ]
          }
        }
      ]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Entry"
      },
      "contains": {
        "properties": {
          "path": {
            "const": "."
          },
          "kind": {
            "const": "directory"
          }
        },
        "required": [
          "path",
          "kind"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    }
  },
  "required": [
    "apiVersion",
    "nodeId",
    "siteId",
    "root",
    "entries"
  ],
  "additionalProperties": false,
  "$defs": {
    "Entry": {
      "type": "object",
      "properties": {
        "path": {
          "anyOf": [
            {
              "const": "."
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[!-~]+$",
              "not": {
                "anyOf": [
                  {
                    "pattern": "\\\\|[^!-~]"
                  },
                  {
                    "pattern": "^/|//|/$|(?:^|/)\\.{1,2}(?:/|$)"
                  }
                ]
              },
              "allOf": [
                {
                  "pattern": "^(?:[^/]+/){0,15}[^/]+$"
                }
              ]
            }
          ]
        },
        "kind": {
          "enum": [
            "directory",
            "file"
          ]
        },
        "uid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "gid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "mode": {
          "type": "string",
          "pattern": "^0[0-7][0-7][0-7]$"
        },
        "size": {
          "$ref": "shared.schema.json#/$defs/UInt63"
        },
        "digest": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind",
        "uid",
        "gid",
        "mode",
        "size",
        "digest"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "directory"
              }
            }
          },
          "then": {
            "properties": {
              "size": {
                "const": "0"
              },
              "digest": {
                "const": ""
              },
              "mode": {
                "pattern": "^0[0-7][0145][0145]$"
              }
            }
          },
          "else": {
            "properties": {
              "digest": {
                "$ref": "shared.schema.json#/$defs/Digest"
              },
              "mode": {
                "pattern": "^0[0246][04][04]$"
              },
              "size": {
                "allOf": [
                  {
                    "$ref": "shared.schema.json#/$defs/UInt63"
                  },
                  {
                    "pattern": "^(?:[0-9]{1,6}|[1-3][0-9]{6}|40[0-9]{5}|41[0-8][0-9]{4}|419[0-3][0-9]{3}|4194[0-2][0-9]{2}|419430[0-4])$"
                  }
                ],
                "description": "File content length in bytes, 0..4194304."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "const": "."
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "directory"
              }
            }
          }
        }
      ]
    }
  }
}
