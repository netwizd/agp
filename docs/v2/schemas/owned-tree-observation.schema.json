{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AGP unsigned local owned tree observation v1alpha1",
  "description": "Describes filesystem metadata/hashes only. Local timestamp; synthetic structural examples do not prove filesystem identity, cryptographic authority, active Nginx, durable backup or CaptureBaseline. Go output bound: 4 MiB.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "agp.owned-tree-observation/v1alpha1"
    },
    "purpose": {
      "const": "filesystem_observation"
    },
    "noExecution": {
      "const": true
    },
    "runtimeValidated": {
      "const": false
    },
    "nodeId": {
      "$ref": "shared.schema.json#/$defs/Id"
    },
    "siteId": {
      "$ref": "shared.schema.json#/$defs/Id"
    },
    "manifestDigest": {
      "$ref": "shared.schema.json#/$defs/Digest"
    },
    "treeDigest": {
      "$ref": "shared.schema.json#/$defs/Digest"
    },
    "root": {
      "type": "string",
      "minLength": 2,
      "maxLength": 1024,
      "pattern": "^/",
      "allOf": [
        {
          "pattern": "^[!-~]+$"
        },
        {
          "not": {
            "anyOf": [
              {
                "pattern": "\\\\|[^!-~]"
              },
              {
                "pattern": "//|/$|(?:^|/)\\.{1,2}(?:/|$)"
              }
            ]
          }
        }
      ]
    },
    "observedAt": {
      "$ref": "shared.schema.json#/$defs/UtcTime"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ObservedEntry"
      },
      "contains": {
        "properties": {
          "path": {
            "const": "."
          },
          "kind": {
            "const": "directory"
          }
        },
        "required": [
          "path",
          "kind"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    }
  },
  "required": [
    "apiVersion",
    "purpose",
    "noExecution",
    "runtimeValidated",
    "nodeId",
    "siteId",
    "manifestDigest",
    "treeDigest",
    "root",
    "observedAt",
    "entries"
  ],
  "additionalProperties": false,
  "$defs": {
    "ObservedEntry": {
      "type": "object",
      "properties": {
        "path": {
          "anyOf": [
            {
              "const": "."
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[!-~]+$",
              "not": {
                "anyOf": [
                  {
                    "pattern": "\\\\|[^!-~]"
                  },
                  {
                    "pattern": "^/|//|/$|(?:^|/)\\.{1,2}(?:/|$)"
                  }
                ]
              },
              "allOf": [
                {
                  "pattern": "^(?:[^/]+/){0,15}[^/]+$"
                }
              ]
            }
          ]
        },
        "kind": {
          "enum": [
            "directory",
            "file"
          ]
        },
        "uid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "gid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "mode": {
          "type": "string",
          "pattern": "^0[0-7][0-7][0-7]$"
        },
        "size": {
          "$ref": "shared.schema.json#/$defs/UInt63"
        },
        "digest": {
          "type": "string"
        },
        "device": {
          "$ref": "shared.schema.json#/$defs/UInt63"
        },
        "inode": {
          "$ref": "shared.schema.json#/$defs/UInt63"
        },
        "mountId": {
          "allOf": [
            {
              "$ref": "shared.schema.json#/$defs/UInt63"
            },
            {
              "not": {
                "const": "0"
              }
            }
          ]
        },
        "links": {
          "$ref": "shared.schema.json#/$defs/UInt63"
        },
        "modifiedAt": {
          "$ref": "shared.schema.json#/$defs/UtcTime"
        },
        "changedAt": {
          "$ref": "shared.schema.json#/$defs/UtcTime"
        }
      },
      "required": [
        "path",
        "kind",
        "uid",
        "gid",
        "mode",
        "size",
        "digest",
        "device",
        "inode",
        "mountId",
        "links",
        "modifiedAt",
        "changedAt"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "directory"
              }
            }
          },
          "then": {
            "properties": {
              "size": {
                "const": "0"
              },
              "digest": {
                "const": ""
              },
              "mode": {
                "pattern": "^0[0-7][0145][0145]$"
              },
              "links": {
                "allOf": [
                  {
                    "$ref": "shared.schema.json#/$defs/UInt63"
                  },
                  {
                    "not": {
                      "const": "0"
                    }
                  }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "digest": {
                "$ref": "shared.schema.json#/$defs/Digest"
              },
              "mode": {
                "pattern": "^0[0246][04][04]$"
              },
              "size": {
                "allOf": [
                  {
                    "$ref": "shared.schema.json#/$defs/UInt63"
                  },
                  {
                    "pattern": "^(?:[0-9]{1,6}|[1-3][0-9]{6}|40[0-9]{5}|41[0-8][0-9]{4}|419[0-3][0-9]{3}|4194[0-2][0-9]{2}|419430[0-4])$"
                  }
                ],
                "description": "File content length in bytes, 0..4194304."
              },
              "links": {
                "const": "1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "const": "."
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "directory"
              }
            }
          }
        }
      ]
    }
  }
}
