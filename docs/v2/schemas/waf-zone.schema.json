{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AGP WAF zone authoring body v1alpha1",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "agp.waf-zone/v1alpha1"
    },
    "kind": {
      "const": "WafZone"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "shared.schema.json#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "siteId": {
          "$ref": "shared.schema.json#/$defs/Id"
        },
        "ownerId": {
          "$ref": "shared.schema.json#/$defs/Id"
        }
      },
      "required": [
        "id",
        "name",
        "siteId",
        "ownerId"
      ],
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "policyRevisionId": {
          "$ref": "shared.schema.json#/$defs/Id"
        },
        "mode": {
          "enum": [
            "detection",
            "blocking"
          ]
        },
        "membership": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "gatewayIds": {
                  "type": "array",
                  "items": {
                    "$ref": "shared.schema.json#/$defs/Id"
                  },
                  "minItems": 1,
                  "maxItems": 10000,
                  "uniqueItems": true
                }
              },
              "required": [
                "gatewayIds"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "matchLabels": {
                  "allOf": [
                    {
                      "$ref": "shared.schema.json#/$defs/Labels"
                    },
                    {
                      "minProperties": 1
                    }
                  ]
                }
              },
              "required": [
                "matchLabels"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "siteDefault": {
                  "const": true
                }
              },
              "required": [
                "siteDefault"
              ],
              "additionalProperties": false
            }
          ]
        },
        "reason": {
          "$ref": "shared.schema.json#/$defs/Reason"
        }
      },
      "required": [
        "policyRevisionId",
        "mode",
        "membership",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
