# Reviewed stable security baseline (2026-11-25). Update with native
# qualification and check-nginx-baseline.py, never by a runtime auto-update.
# Sources: https://nginx.org/en/download.html
# https://github.com/nginx/documentation/blob/main/content/nginx/admin-guide/installing-nginx/installing-nginx-open-source.md
AGP_NGINX_QUALIFIED_VERSION=1.30.8
AGP_NGINX_SECURITY_FLOOR=1.30.8
AGP_NGINX_REQUIRED_MODULES='--with-http_auth_request_module --with-http_ssl_module --with-http_v2_module'
# Apt repository identity and source release identity are separate keys.
AGP_NGINX_SIGNING_FINGERPRINT=8540A6F18833A80E9C1653A42FD21310B49F6B46
