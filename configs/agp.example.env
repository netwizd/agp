AGP_HTTP_ADDR=127.0.0.1:8080
AGP_PORTAL_HOST=portal.company.ru
# Изоляция management S0.2a опциональна; пустое значение сохраняет legacy routing.
# Канонический HTTPS origin отдельного hostname, без пути: https://management.example
# Требует AGP_COOKIE_SECURE=true и явной активации session-profile с reset sessions.
# Процедура и rollback: docs/operations.md, «Изоляция management: S0.2a».
AGP_MANAGEMENT_ORIGIN=
AGP_DATABASE_DRIVER=postgres
AGP_DATABASE_DSN=postgres://agp:change-me@127.0.0.1:5432/agp?sslmode=disable
AGP_DATABASE_PATH=/var/lib/agp/agp.db
AGP_DOWNLOADS_DIR=/var/lib/agp/downloads
AGP_DOWNLOAD_MAX_BYTES=268435456
AGP_SESSION_COOKIE_NAME=agp_session
AGP_CSRF_COOKIE_NAME=agp_csrf
AGP_COOKIE_SECURE=true
AGP_TRUST_PROXY_HEADERS=false
AGP_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
AGP_SESSION_TTL=8h
AGP_SESSION_RETENTION=720h
AGP_AUDIT_RETENTION=8760h
AGP_SHUTDOWN_TIMEOUT=10s
AGP_LOGIN_RATE_LIMIT_MAX=5
AGP_LOGIN_RATE_LIMIT_WINDOW=1m
AGP_DOWNLOAD_ALLOWED_EXTENSIONS=.zip,.rar,.7z,.msi,.exe,.pkg,.dmg,.pdf,.txt,.rdp,.ovpn,.conf
AGP_DOWNLOAD_SCAN_COMMAND=
AGP_DOWNLOAD_SCAN_TIMEOUT=30s
AGP_DIAGNOSTICS_ALLOW_CIDRS=
AGP_DIAGNOSTICS_DENY_CIDRS=127.0.0.0/8,::1/128,169.254.0.0/16,fe80::/10,0.0.0.0/8,::/128
AGP_DIAGNOSTICS_RATE_LIMIT_MAX=30
AGP_DIAGNOSTICS_RATE_LIMIT_WINDOW=1m

# Secure single-node S0 pilot: включать только после процедуры docs/operations.md.
# Нужны PostgreSQL primary напрямую, отдельные management/login/app hostnames и PKI.
AGP_SECURE_PROFILE=false
AGP_LOGIN_ORIGIN=
# Приватный JSON keyring AES-256; AGP_MFA_KEY_FILE — совместимый alias.
AGP_MFA_KEYRING_FILE=
AGP_AUTH_MTLS_ADDR=127.0.0.1:8444
AGP_AUTH_MTLS_CERT_FILE=
AGP_AUTH_MTLS_KEY_FILE=
AGP_AUTH_MTLS_CLIENT_CA_FILE=
# CP → независимый journal: отдельная CA/client identity, hex Ed25519 public key.
AGP_JOURNAL_URL=
AGP_JOURNAL_AUTHORITY_ID=
AGP_JOURNAL_KEY_ID=
AGP_JOURNAL_PUBLIC_KEY=
AGP_JOURNAL_CLIENT_CERT=
AGP_JOURNAL_CLIENT_KEY=
AGP_JOURNAL_CA=
# AGP_JOURNAL_DATABASE_DSN задаётся отдельно процессу journal, не CP.

# Optional own contacts/email confirmation: только secure PostgreSQL profile.
# Protected installation JSON agp.email/v1alpha1; отдельный email keyring и
# purpose-bound secret manifest вне CP backup. SMTP endpoint не задаётся браузером.
# Setup/restart/rollback: docs/operations.md, «Контакты и SMTP (opt-in)».
# Пустое значение отключает email; plaintext SMTP/automatic retry не поддерживаются.
# AGP_EMAIL_CONFIG_FILE=/etc/agp/email/config.json

# Optional AD-backed OIDC: только secure PostgreSQL profile и live AD connector.
# Protected agp.oidc-connector/v1alpha1: trusted origins/CIDRs, external secret
# manifest и отдельный agp.oidc-state-keyring/v1alpha1 (не MFA/email keys).
# Login/management clients и exact issuer/sub links согласуются раздельно.
# Setup/restart/rollback: docs/operations.md, «AD-backed OIDC (opt-in)».
# AGP_OIDC_CONNECTOR_FILE=/etc/agp/oidc/config.json

# Opt-in S1/S1b authoring: secure PostgreSQL; global или bootstrap-only Site scopes.
# Persisted legacy-write fence включается отдельно offline CLI configuration-profile.
# Draft/preview не выполняют apply/reload; см. docs/operations.md «S1 authoring pilot».
AGP_CONFIGURATION_ENABLED=false

# Optional native WAF provider: требует secure profile и configuration authoring.
# Public trust anchor и independent repository готовит trust administrator;
# repository находится вне CP backup/restore и доступен CP только для чтения.
# AGP_WAF_TRUST_CONFIG=/etc/agp-waf/trust.json
# AGP_WAF_REPOSITORY_DIR=/var/lib/agp-waf-repository
# AGP_WAF_TEMP_DIR=/var/lib/agp-waf-scratch

# Optional read-only agent inventory: только secure configuration profile.
# Первые четыре значения задают вместе; отдельный TLS1.3 port, свои cert/key/CA.
# Ровно один identity source: AGP_AGENT_REGISTRY_FILE либо AGP_NODE_IDENTITY_CONFIG.
# Registry — installation-owned публичные preregistrations вне CP backup/restore,
# absolute clean protected path без symlinks/доступных на запись предков.
# External registry не включает issuer. Managed agent enrollment описан ниже.
# Helper/apply не реализованы; runbook: docs/operations.md.
AGP_AGENT_MTLS_ADDR=
AGP_AGENT_MTLS_CERT_FILE=
AGP_AGENT_MTLS_KEY_FILE=
AGP_AGENT_MTLS_CLIENT_CA_FILE=
AGP_AGENT_REGISTRY_FILE=

# Optional managed agent identity: вместо AGP_AGENT_REGISTRY_FILE (он пустой).
# Protected issuer-client JSON; CA key/ledger хранятся у отдельного issuer вне CP restore.
# Требует все четыре AGP_AGENT_MTLS_* выше и все три enrollment значения ниже.
# Enrollment TLS1.3 server-auth port/cert/key отдельны от browser/EdgeAuth/agent mTLS.
# Только agent role + current admin/fresh MFA; trusted provisioning пока ручной.
AGP_NODE_IDENTITY_CONFIG=
AGP_ENROLLMENT_TLS_ADDR=
AGP_ENROLLMENT_TLS_CERT_FILE=
AGP_ENROLLMENT_TLS_KEY_FILE=
